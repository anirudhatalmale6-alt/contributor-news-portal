// Contributor News Portal - data model
// Database: PostgreSQL (swap `provider` for mysql/sqlite if you prefer)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// The owner. The only role that can change how the site looks, what it pays,
  /// and who else is staff.
  SUPERADMIN
  /// Runs the newsroom day to day: everything editorial, plus making
  /// contributors into editors. No access to design or money settings.
  ADMIN
  EDITOR
  CONTRIBUTOR
}

enum ContributorTier {
  GENERAL
  VERIFIED
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MediaKind {
  IMAGE
  VIDEO
}

// The site runs in two languages: every piece has an original and an editor's
// translation into the other one.
enum Locale {
  EN
  BN
}

enum PayoutMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  PAYPAL
  WISE
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String? // null when the account came from Google / a social provider
  image        String?
  role         Role            @default(CONTRIBUTOR)
  tier         ContributorTier @default(GENERAL)
  bio          String?

  /// What a contributor chooses to show on their public page. The account email
  /// is never published - `publicEmail` is a separate field they opt into.
  publicEmail String?
  /// Required of every contributor, and visible to the newsroom only. Readers
  /// see it only if the contributor deliberately turns `phonePublic` on.
  phone       String?
  whatsapp    String?
  phonePublic Boolean @default(false)
  website     String?
  location    String?

  /// A suspended contributor cannot sign in or write. Their published work
  /// stays published, because that was an editorial decision already made.
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedById   String?
  suspendedBy     User?     @relation("suspender", fields: [suspendedById], references: [id])
  suspended       User[]    @relation("suspender")

  createdAt       DateTime             @default(now())
  articles        Article[]            @relation("author")
  reviewed        Article[]            @relation("reviewer")
  accounts        OAuthAccount[]
  reviews         Review[]
  payout          PayoutProfile?
  translations    ArticleTranslation[] @relation("translator")
  threads         ThreadMember[]
  sent            InboxMessage[]       @relation("sender")
  startedThreads  InboxThread[]        @relation("threadStarter")
  adjustments     EarningAdjustment[]  @relation("adjusted")
  adjustmentsMade EarningAdjustment[]  @relation("adjuster")
  notifications   Notification[]
  payoutRequests  PayoutRequest[]      @relation("requester")
  payoutsDecided  PayoutRequest[]      @relation("payoutDecider")
  notices         Notice[]             @relation("noticeFor")
  noticesWritten  Notice[]             @relation("noticeAuthor")
  dismissals      NoticeDismissal[]
  passwordResets  PasswordReset[]
}

/// Where a contributor wants their payouts sent. Visible to the contributor
/// themselves and to an Admin; editors never see these numbers.
model PayoutProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        PayoutMethod
  accountName   String // name exactly as it appears on the account
  walletNumber  String? // bKash / Nagad / Rocket
  bankName      String?
  branch        String?
  accountNumber String?
  routingNumber String?
  email         String? // PayPal / Wise
  country       String       @default("Bangladesh")
  note          String?
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())
}

// One row per linked social identity (google, facebook, ...)
model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Article {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  dek        String? // standfirst / summary shown in the feed
  body       String // markdown-ish rich text
  coverImage String?
  category   String        @default("General")
  status     ArticleStatus @default(DRAFT)
  authorId   String
  author     User          @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?         @relation("reviewer", fields: [reviewerId], references: [id])

  // payout, in minor units (poisha for BDT) so money never touches a float
  payoutCents Int @default(0)

  /// Approving a piece publishes it; featuring is a separate, deliberate act,
  /// so the front page is edited rather than just filled by whatever is newest.
  featured   Boolean   @default(false)
  featuredAt DateTime?

  // The language the contributor wrote in; the other one comes from the editor.
  language Locale @default(EN)

  /// How the cover is cropped for each place it appears, as "x,y,w,h" in
  /// percentages of the original picture. Null means show the middle of it.
  /// Two separate crops because the front page wants a wide strip and the
  /// article page wants more of the picture.
  coverCropHome    String?
  coverCropArticle String?

  /// Where an editor has pinned this piece on the front page:
  /// LEAD, STRIP (beside the masthead), LEFT, MIDDLE or RIGHT. Null means the
  /// page decides for itself, newest first, which is what most pieces do.
  homeSlot  String?
  /// Order within a slot, lowest first.
  homeOrder Int     @default(0)

  /// The name a reader sees. Empty for a contributor's own piece, where the
  /// writer is the byline; set by the desk when it files something under a
  /// correspondent's name rather than the editor's own account.
  bylineName String?

  /// Who saw it happen, if the contributor knows. Names, addresses and phone
  /// numbers of witnesses: newsroom-only, never published, and never required.
  witnesses String?

  /// How the desk reaches the writer about THIS piece - a story often needs a
  /// follow-up call, and the number on file may not be the right one.
  contactPhone    String?
  contactWhatsapp String?

  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media        Media[]
  reviews      Review[]
  threads      InboxThread[]
  translations ArticleTranslation[]

  @@index([status, publishedAt])
  @@index([status, featured, featuredAt])
  @@index([authorId, status])
}

/// The editor's translation of a piece into the other language. One row per
/// article per locale, so a Bangla original and its English version live
/// side by side and share the same media.
model ArticleTranslation {
  id           String   @id @default(cuid())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale       Locale
  title        String
  dek          String?
  body         String
  slug         String   @unique
  translatorId String?
  translator   User?    @relation("translator", fields: [translatorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([articleId, locale])
  @@index([locale])
}

/// Uploaded bytes, when STORAGE_DRIVER=db. Serverless hosts (Vercel and the
/// like) have no writable disk that survives a request, so the database is the
/// one place every host agrees on. On a VPS leave the driver on `disk`.
model MediaBlob {
  id          String   @id // the file name used in /media/<id>
  contentType String
  size        Int
  bytes       Bytes
  createdAt   DateTime @default(now())
}

model Media {
  id           String    @id @default(cuid())
  articleId    String
  article      Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  kind         MediaKind
  url          String
  caption      String?
  /// The name the contributor's file had, so an editor downloading it to work
  /// on gets something recognisable rather than a UUID.
  originalName String?
  /// Readers only see what an editor has put in the Evidence gallery. The rest
  /// of a contributor's upload stays inside the newsroom.
  isEvidence   Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([articleId, isEvidence, sortOrder])
}

// Audit trail: every approve / reject / resubmit, with the editor's note
model Review {
  id         String         @id @default(cuid())
  articleId  String
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editorId   String?
  editor     User?          @relation(fields: [editorId], references: [id])
  action     String // SUBMITTED | APPROVED | REJECTED | RESUBMITTED | PAYOUT_UPDATED
  note       String?
  fromStatus ArticleStatus?
  toStatus   ArticleStatus?
  createdAt  DateTime       @default(now())

  @@index([articleId, createdAt])
}

/// Everything the owner can change without touching code: the masthead, the
/// wording around the site, and the advertising slots. One row, id = 1.
model SiteSettings {
  id              Int     @id @default(1)
  siteNameEn      String  @default("The Document")
  siteNameBn      String  @default("দ্য ডকুমেন্ট")
  taglineEn       String  @default("news written by its readers, checked by its editors.")
  taglineBn       String  @default("পাঠকদের লেখা, সম্পাদকদের যাচাই করা সংবাদ।")
  footerEn        String  @default("© The Document. All rights reserved.")
  footerBn        String  @default("© দ্য ডকুমেন্ট। সর্বস্বত্ব সংরক্ষিত।")

  /// Footer links. An empty address hides that link rather than printing a
  /// dead one; the words themselves are edited in Wording.
  footerAboutUrl   String @default("")
  footerContactUrl String @default("")
  footerPrivacyUrl String @default("")

  /// Shows today's date across the foot of every public page.
  footerShowDate Boolean @default(true)

  /// How many pieces each part of the front page may carry.
  maxLeftRail     Int @default(3)
  maxRightRail    Int @default(4)
  maxUnderLead    Int @default(2)
  maxMoreGrid     Int @default(12)
  /// And how many "more on this" blocks an article page shows.
  maxRelated      Int @default(8)

  /// When off, a contributor cannot start a thread with another contributor.
  /// Off to begin with: most of them do not know each other, and writing to
  /// the newsroom is a separate channel that is never blocked.
  contributorMessaging Boolean @default(false)
  /// Uploaded masthead; falls back to the bundled artwork when empty.
  logoUrl         String?
  /// Ad slots. The HTML is pasted by an Admin and rendered as-is, which is what
  /// an ad network requires; nobody else can reach these fields.
  ///
  /// The unsuffixed fields are the BANGLA site. The `...En` ones are the
  /// English site, and start empty: an advertiser who bought space on one half
  /// of the paper has not bought the other.
  adsEnabled      Boolean @default(false)
  adHomeHtml      String  @default("")
  adArticleHtml   String  @default("")
  adSectionHtml   String  @default("")
  /// A wide strip across the page, and a square block in a side column. Kept
  /// separate because an ad network gives you different code for each shape.
  adBannerHtml    String  @default("")
  adSquareHtml    String  @default("")
  adHomeHtmlEn    String  @default("")
  adArticleHtmlEn String  @default("")
  adSectionHtmlEn String  @default("")
  adBannerHtmlEn  String  @default("")
  adSquareHtmlEn  String  @default("")
  /// Which Bengali face readers get for article text.
  banglaFont      String  @default("hind-siliguri")
}

// Single-row table the Admin edits under Payment settings
model PaymentSettings {
  id               Int    @id @default(1)
  currency         String @default("BDT")
  defaultPayout    Int    @default(150000) // minor units (poisha), pre-filled in the editor's payout box
  verifiedBonusPct Int    @default(20) // Verified Contributors get +20% suggested
  payoutNote       String @default("Payouts are estimates and are settled on the 1st of each month.")

  /// When on, an editor cannot publish a piece until the translation exists.
  requireTranslation Boolean @default(true)

  /// What a contributor has to have earned before they can ask to be paid,
  /// in minor units. 50000 poisha is BDT 500.
  minPayoutCents Int @default(50000)
}

/// A conversation between the newsroom and a contributor, or between two
/// members of staff. Kept inside the site on purpose: a contributor should not
/// need an editor's personal phone number to ask a question about their piece.
model InboxThread {
  id      String @id @default(cuid())
  subject String

  /// A desk thread is addressed to the newsroom rather than to one person, so
  /// any editor or admin can read and answer it. Without this, a question would
  /// sit unanswered whenever the one editor named on it was away.
  desk Boolean @default(false)

  /// Set when the conversation is about a specific submission.
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  startedById String?
  startedBy   User?   @relation("threadStarter", fields: [startedById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  /// Denormalised so the list can sort without touching every message.
  lastMessageAt DateTime @default(now())

  members  ThreadMember[]
  messages InboxMessage[]

  @@index([lastMessageAt])
  @@index([desk, lastMessageAt])
}

model ThreadMember {
  id       String      @id @default(cuid())
  threadId String
  thread   InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Everything before this moment has been seen; anything after it is unread.
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
}

model InboxMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String?
  sender   User?       @relation("sender", fields: [senderId], references: [id], onDelete: SetNull)

  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

/// A hand-made correction to what a contributor has earned: a bonus for a piece
/// that did more than its payout, or a deduction when an earning is voided.
///
/// Kept as its own signed ledger rather than by editing the payout on an
/// article, because the payout is what an editor agreed for that piece and the
/// history of it should stay readable afterwards.
model EarningAdjustment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("adjusted", fields: [userId], references: [id], onDelete: Cascade)

  /// Signed minor units. Positive adds to the total, negative takes away.
  amountCents Int
  /// Required: whoever reads the ledger later needs to know why.
  reason      String

  createdById String?
  createdBy   User?    @relation("adjuster", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// What a contributor is told when something happens to their work or their
/// account: a piece published, a piece sent back, a change of role.
///
/// Separate from the inbox on purpose. The inbox is a conversation somebody
/// chose to start; this is the paper's own record of a decision, and a
/// contributor should not have to read a thread to find out they were published.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// PUBLISHED | REJECTED | ROLE | PAYOUT - kept as a string so adding a kind
  /// never needs a migration.
  kind  String
  title String
  body  String?
  /// Where to go when it is clicked, if anywhere.
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One line of wording the owner has changed, for one language.
///
/// Absent means "use what the site shipped with", which is why resetting a line
/// deletes the row rather than storing the default back again.
model UiText {
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@id([key, locale])
}


enum PayoutRequestStatus {
  PENDING
  PAID
  DECLINED
}

/// A contributor asking to be paid what they have earned.
///
/// The destination is COPIED onto the request rather than read from the
/// contributor's profile when an admin looks at it. If they change their bKash
/// number after asking, the desk must still be able to see what it was asked
/// to pay - and be told the two no longer agree before sending money.
model PayoutRequest {
  id     String              @id @default(cuid())
  userId String
  user   User                @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  status PayoutRequestStatus @default(PENDING)

  /// What was owed at the moment of asking, in minor units.
  amountCents Int

  /// Where it was to be sent, as it read when the request was made.
  method      String
  accountName String
  destination String

  /// What the contributor wrote, and what the desk wrote back.
  note        String?
  decidedNote String?

  decidedById String?
  decidedBy   User?     @relation("payoutDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}


/// Something the desk wants a contributor to see when they next sign in.
///
/// One mechanism, two uses: with no `userId` it is for everybody, and with one
/// it is a note for that person alone. It sits at the top of their dashboard
/// until they close it, and closing it is recorded per person so one reader
/// dismissing it does not take it off everybody else's screen.
model Notice {
  id        String   @id @default(cuid())
  body      String
  /// Null means everyone. Set means this person only.
  userId    String?
  user      User?    @relation("noticeFor", fields: [userId], references: [id], onDelete: Cascade)
  writtenById String
  writtenBy   User   @relation("noticeAuthor", fields: [writtenById], references: [id])
  /// Taken down by the desk, as opposed to dismissed by a reader.
  retiredAt DateTime?
  createdAt DateTime @default(now())

  dismissals NoticeDismissal[]

  @@index([userId, retiredAt])
}

/// One row per person who has closed a notice.
model NoticeDismissal {
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())

  @@id([noticeId, userId])
}


/// A one-time link that lets somebody choose a new password.
///
/// The token itself is never stored - only its hash - so a copy of the
/// database does not hand somebody every live reset link. One hour to use it,
/// and using it burns it.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
